{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliCacheExporter",
  "version": "2.0.1",
  "identifier": "local.bilicacheexporter.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Bili 快取匯出", "width": 1040, "height": 760, "minWidth": 420, "minHeight": 480, "visible": false }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
